# ==============================================================================
# Datheon FastAPI Internship - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CONFIGURATION VALUES
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Application Settings
PROJECT_NAME="Datheon BookStore API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
DEBUG=True

# Database Configuration
# Local SQLite with asynchronous aiosqlite driver
DATABASE_URL="sqlite+aiosqlite:///./datheon_bookstore.db"
# Test database URL used by pytest
TEST_DATABASE_URL="sqlite+aiosqlite:///./test_datheon_bookstore.db"

# JWT Authentication & Cryptography
# Generate a secure key in PowerShell: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="replace_this_with_a_secure_random_secret_key_minimum_32_characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting Configuration
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="5/minute"
RATE_LIMIT_DEFAULT="100/minute"

# Admin Account Bootstrapping (Used by scripts/create_admin.py)
BOOTSTRAP_ADMIN_EMAIL="admin@datheon.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeAdmin123!"
